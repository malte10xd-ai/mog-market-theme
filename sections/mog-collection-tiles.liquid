{%- style -%}
  #shopify-section-{{ section.id }} .mog-tiles-wrap {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .mog-tiles__item {
    aspect-ratio: {{ section.settings.tile_ratio }};
  }

  /* Handy: bleibt eine Kachel allein in der letzten Reihe, geht sie über die volle Breite */
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .mog-tiles__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      aspect-ratio: 2 / 1;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .mog-tiles-wrap {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .mog-tiles__list {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="mog-tiles-wrap page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="mog-tiles__title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <ul class="mog-tiles__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign tile_title = block.settings.title
          if tile_title == blank and collection != blank
            assign tile_title = collection.title
          endif
          assign tile_image = block.settings.image
          assign tile_link = collection.url
          if block.settings.link != blank
            assign tile_link = block.settings.link
          endif
        -%}
        <li class="mog-tiles__item" {{ block.shopify_attributes }}>
          <a
            class="mog-tiles__link"
            {% if tile_link != blank %}
              href="{{ tile_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'mog-tiles__image',
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  alt: tile_image.alt
              }}
            {%- elsif block.settings.theme_image != blank -%}
              <img
                class="mog-tiles__image"
                src="{{ block.settings.theme_image | asset_url }}"
                alt=""
                width="1024"
                height="1280"
                loading="lazy"
              >
            {%- else -%}
              <div class="mog-tiles__image mog-tiles__image--placeholder">
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
            <span class="mog-tiles__label">
              <span class="mog-tiles__name">{{ tile_title | default: 'Kollektion' | escape }}</span>
              <span class="mog-tiles__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- stylesheet -%}
  .mog-tiles__title {
    margin: 0 0 2rem;
  }

  .mog-tiles__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .mog-tiles__list {
      gap: 1.6rem;
    }
  }

  .mog-tiles__item {
    position: relative;
    overflow: hidden;
    background: #ece8e1;
  }

  .mog-tiles__link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    color: #fff;
    text-decoration: none;
  }

  .mog-tiles__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .mog-tiles__image--placeholder svg {
    width: 100%;
    height: 100%;
    background: #ece8e1;
    fill: #16181a;
    opacity: 0.35;
  }

  .mog-tiles__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(22, 24, 26, 0.82) 0%, rgba(22, 24, 26, 0) 55%);
    pointer-events: none;
  }

  .mog-tiles__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1.2rem 1.4rem;
  }

  .mog-tiles__name {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .mog-tiles__arrow {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    background: #9fd5f5;
    color: #16181a;
  }

  @media screen and (min-width: 750px) {
    .mog-tiles__name {
      font-size: 2rem;
    }

    .mog-tiles__label {
      padding: 1.8rem 2rem;
    }
  }

  @media (hover: hover) {
    .mog-tiles__link:hover .mog-tiles__image {
      transform: scale(1.04);
    }
  }

  .mog-tiles__link:focus-visible {
    outline: 3px solid #9fd5f5;
    outline-offset: -3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mog-tiles__image {
      transition: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Mog: Kollektionskacheln",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Überschrift",
      "default": "Kollektionen"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Größe der Überschrift",
      "options": [
        { "value": "h1", "label": "Groß" },
        { "value": "h2", "label": "Mittel" },
        { "value": "h3", "label": "Klein" }
      ],
      "default": "h2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "Format der Kacheln",
      "options": [
        { "value": "1 / 1", "label": "Quadrat" },
        { "value": "4 / 5", "label": "Hochformat" },
        { "value": "3 / 4", "label": "Hochformat, schmal" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Kacheln pro Reihe (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kachel",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel (leer = Name der Kollektion)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild (leer = mitgeliefertes Bild bzw. Platzhalter)"
        },
        {
          "type": "text",
          "id": "theme_image",
          "label": "Mitgeliefertes Bild (Dateiname im Theme)",
          "info": "Wird nur genutzt, wenn oben kein Bild gewählt ist. Z. B. mog-tile-spritzen.jpg"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Eigener Link (leer = Link zur Kollektion)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mog: Kollektionskacheln",
      "blocks": [
        { "type": "tile", "settings": { "title": "Spritzen" } },
        { "type": "tile", "settings": { "title": "Hygiene" } },
        { "type": "tile", "settings": { "title": "Entsorgung" } },
        { "type": "tile", "settings": { "title": "Zubehör" } }
      ]
    }
  ]
}
{% endschema %}
